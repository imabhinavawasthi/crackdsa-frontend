# ==============================================================================
# CrackDSA Frontend — Environment Configuration Template
# ==============================================================================
# Duplicate this file as .env or .env.local and populate with your credentials.
# Note: Variables exposed to the browser MUST start with NEXT_PUBLIC_.
# NEVER commit real secret keys, private tokens, or production values.
# ==============================================================================

# Backend API Base URL (e.g., http://localhost:8000 for local dev or production URL)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Google OAuth entry URL / Supabase Auth provider endpoint
NEXT_PUBLIC_GOOGLE_AUTH_URL=https://<your-supabase-project>.supabase.co/auth/v1/authorize?provider=google&access_type=offline&prompt=consent

# Razorpay Key ID (rzp_test_... for local testing, rzp_live_... for production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Optional: Default DSA Course Slug for curriculum and syllabus mapping
NEXT_PUBLIC_DSA_COURSE_SLUG=data-structures-algorithms-mastery-program
